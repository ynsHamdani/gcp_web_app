# Generate each value independently; never commit the real .env file.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
GCP_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
RASTER_SIGNING_KEY=replace_with_a_separate_random_secret

# Local HTTP development: false. Set true when running behind HTTPS in production.
SESSION_COOKIE_SECURE=false
